{
  "name": "nanobrowser",
  "version": "0.3.0",
  "private": true,
  "description": "AI web automation Chrome extension",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nanobrowser/nanobrowser.git"
  },
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "type-check": "wxt prepare && tsc --noEmit",
    "lint": "eslint . --cache --cache-location node_modules/.cache/.eslintcache",
    "prettier": "prettier . --write --cache --cache-location node_modules/.cache/.prettiercache",
    "fixtures": "node fixtures/server.mjs",
    "autorun": "node fixtures/autorun.mjs",
    "upgrade-test": "node fixtures/upgrade-test.mjs",
    "install-chrome": "node fixtures/chrome.mjs install",
    "clean-chrome": "node fixtures/chrome.mjs clean",
    "clean": "rimraf dist dist-zip .wxt .output"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/openai": "4.0.83",
    "@radix-ui/react-dialog": "^1.1.23",
    "ai": "7.0.126",
    "idb": "^8.0.3",
    "puppeteer-core": "^25.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.19.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.17",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "5.0.2",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": "^10.34.6",
    "npm": "please-use-pnpm"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
